<?xml version="1.0"?>
<flowgorithm fileversion="2.18">
  <attributes>
    <attribute name="name" value="Автобусны карт - Хялбар хувилбар"/>
    <attribute name="authors" value="APL121 Student"/>
    <attribute name="about" value="Code Quest topic 14 - simplified"/>
    <attribute name="saved" value="2026-10-28 16:00:00"/>
    <attribute name="created" value="2026-10-28 16:00:00"/>
    <attribute name="edited" value="2026-10-28 16:00:00"/>
  </attributes>
  <function name="DailyCost" type="Integer" variable="cost">
    <parameters>
      <parameter name="rides" type="Integer" array="False"/>
    </parameters>
    <body>
      <declare name="cost" type="Integer" array="False" size=""/>
      <if expression="rides == 0">
        <then>
          <assign variable="cost" expression="0"/>
        </then>
        <else>
          <assign variable="cost" expression="1000 + (rides - 1) * 500"/>
        </else>
      </if>
      <return expression="cost"/>
    </body>
  </function>
  <function name="Main" type="None" variable="">
    <parameters/>
    <body>
      <declare name="balance" type="Integer" array="False" size=""/>
      <declare name="rides" type="Integer" array="False" size=""/>
      <declare name="day" type="Integer" array="False" size=""/>
      <declare name="cost" type="Integer" array="False" size=""/>
      <declare name="total" type="Integer" array="False" size=""/>
      <declare name="rechargeDay" type="Integer" array="False" size=""/>
      <declare name="d1" type="Integer" array="False" size=""/>
      <declare name="d2" type="Integer" array="False" size=""/>
      <declare name="d3" type="Integer" array="False" size=""/>
      <declare name="tmp" type="Integer" array="False" size=""/>
      <assign variable="total" expression="0"/>
      <assign variable="rechargeDay" expression="0"/>
      <assign variable="d1" expression="0"/>
      <assign variable="d2" expression="0"/>
      <assign variable="d3" expression="0"/>
      <output expression="&quot;Ehnii uldegdel (0-100000):&quot;" newline="True"/>
      <input variable="balance"/>
      <while expression="balance &lt; 0 || balance &gt; 100000">
        <output expression="&quot;Buruu! 0-100000 hoorond dahin oruul:&quot;" newline="True"/>
        <input variable="balance"/>
      </while>
      <for variable="day" start="1" end="7" step="1">
        <output expression="&quot;Odor &quot; &amp; day &amp; &quot;-iin suult (0-20):&quot;" newline="True"/>
        <input variable="rides"/>
        <while expression="rides &lt; 0 || rides &gt; 20">
          <output expression="&quot;Buruu! 0-20 hoorond dahin oruul:&quot;" newline="True"/>
          <input variable="rides"/>
        </while>
        <assign variable="cost" expression="DailyCost(rides)"/>
        <if expression="balance &gt;= cost">
          <then>
            <assign variable="balance" expression="balance - cost"/>
            <assign variable="total" expression="total + cost"/>
          </then>
          <else>
            <if expression="rechargeDay == 0">
              <then>
                <assign variable="rechargeDay" expression="day"/>
              </then>
              <else/>
            </if>
          </else>
        </if>
        <if expression="day == 1">
          <then>
            <assign variable="d1" expression="cost"/>
          </then>
          <else>
            <if expression="day == 2">
              <then>
                <assign variable="d2" expression="cost"/>
              </then>
              <else>
                <if expression="day == 3">
                  <then>
                    <assign variable="d3" expression="cost"/>
                  </then>
                  <else/>
                </if>
              </else>
            </if>
          </else>
        </if>
        <output expression="&quot;Zardal: &quot; &amp; cost &amp; &quot; | Uldegdel: &quot; &amp; balance" newline="True"/>
      </for>
      <if expression="d1 &gt; d2">
        <then>
          <assign variable="tmp" expression="d1"/>
          <assign variable="d1" expression="d2"/>
          <assign variable="d2" expression="tmp"/>
        </then>
        <else/>
      </if>
      <if expression="d1 &gt; d3">
        <then>
          <assign variable="tmp" expression="d1"/>
          <assign variable="d1" expression="d3"/>
          <assign variable="d3" expression="tmp"/>
        </then>
        <else/>
      </if>
      <if expression="d2 &gt; d3">
        <then>
          <assign variable="tmp" expression="d2"/>
          <assign variable="d2" expression="d3"/>
          <assign variable="d3" expression="tmp"/>
        </then>
        <else/>
      </if>
      <output expression="&quot;--- 7 honogiin dun ---&quot;" newline="True"/>
      <output expression="&quot;Niit zardal: &quot; &amp; total" newline="True"/>
      <output expression="&quot;Uldegdel: &quot; &amp; balance" newline="True"/>
      <if expression="rechargeDay == 0">
        <then>
          <output expression="&quot;Tsenegleh shaardlaga garaagui.&quot;" newline="True"/>
        </then>
        <else>
          <output expression="&quot;Tsenegleh ehnii odor: &quot; &amp; rechargeDay" newline="True"/>
        </else>
      </if>
      <output expression="&quot;Ehnii 3 udriin zardal bagaas ih: &quot; &amp; d1 &amp; &quot;, &quot; &amp; d2 &amp; &quot;, &quot; &amp; d3" newline="True"/>
    </body>
  </function>
</flowgorithm>
